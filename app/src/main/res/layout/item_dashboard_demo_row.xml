<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/btnDemoHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <View
            android:id="@+id/demoDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_dashboard_demo_dot" />

        <TextView
            android:id="@+id/tvDemoLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textColor="@color/dashboard_ink"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Male" />

        <TextView
            android:id="@+id/tvDemoValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:textColor="@color/dashboard_ink"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="20" />

        <ImageView
            android:id="@+id/ivDemoChevron"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_down"
            app:tint="@color/dashboard_ink_muted" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutDemoDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_dashboard_class_panel"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
