<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="#F3F8F7">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/sync_summary_scope" android:textSize="13sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
    <Button android:id="@+id/refresh_summary" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" android:text="@string/sync_summary_refresh" />
    <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/summary_share" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_margin="8dp"
        android:src="@android:drawable/ic_menu_share"
        android:contentDescription="@string/sync_share_title" app:fabSize="mini"
        app:backgroundTint="#176B68" app:tint="@android:color/white" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:baselineAligned="false" android:layout_marginBottom="8dp">
        <Button android:id="@+id/summary_today" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:minHeight="48dp" android:minWidth="0dp" android:paddingHorizontal="8dp" android:textSize="12sp"
            android:layout_marginEnd="4dp" android:text="@string/sync_summary_today" />
        <Button android:id="@+id/summary_yesterday" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:minHeight="48dp" android:minWidth="0dp" android:paddingHorizontal="8dp" android:textSize="12sp"
            android:layout_marginHorizontal="4dp" android:text="@string/sync_summary_yesterday" />
        <Button android:id="@+id/summary_all" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:minHeight="48dp" android:minWidth="0dp" android:paddingHorizontal="8dp" android:textSize="12sp"
            android:layout_marginStart="4dp" android:text="@string/sync_summary_all" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:baselineAligned="false" android:layout_marginBottom="12dp">
        <Button android:id="@+id/summary_push" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:minHeight="48dp" android:minWidth="0dp" android:paddingHorizontal="8dp"
            android:layout_marginEnd="4dp" android:text="@string/sync_summary_push" android:textSize="12sp" />
        <Button android:id="@+id/summary_pull" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:minHeight="48dp" android:minWidth="0dp" android:paddingHorizontal="8dp"
            android:layout_marginStart="4dp" android:text="@string/sync_summary_pull" android:textSize="12sp" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/summary_list"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:paddingBottom="16dp" android:clipToPadding="false" />
</LinearLayout>
