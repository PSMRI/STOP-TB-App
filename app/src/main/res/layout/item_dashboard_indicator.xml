<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="0dp"
    app:cardBackgroundColor="@color/dashboard_card_orange"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <FrameLayout
                android:id="@+id/flIndicatorIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_dashboard_icon_orange">

                <ImageView
                    android:id="@+id/ivIndicatorIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_health_symptom"
                    app:tint="@android:color/white" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvIndicatorCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:textColor="@color/dashboard_icon_orange"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="9" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvIndicatorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/dashboard_ink"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Total Presumptive Cases Summary" />

        <View
            android:id="@+id/viewDemographicDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/dashboard_row_divider" />

        <LinearLayout
            android:id="@+id/btnViewDemographic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="9dp"
            android:paddingBottom="9dp">

            <TextView
                android:id="@+id/tvViewDemographic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dashboard_view_by_demographic"
                android:textColor="@color/dashboard_icon_teal"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivDemographicChevron"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/dashboard_icon_teal" />
        </LinearLayout>

        <ViewStub
            android:id="@+id/stubDemographicDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout="@layout/item_dashboard_demo_accordion" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
