<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_page_bg"
    android:fillViewport="true"
    tools:context=".ui.home_activity.dashboard.DashboardFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tvFilterScope"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/dashboard_ink"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="All Villages" />

                <TextView
                    android:id="@+id/tvFilterScopePeriod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/dashboard_ink_muted"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="This Month" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnOpenFilters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dashboard_filter_chip"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_filters"
                    android:textColor="@color/dashboard_highlight_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="2dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/dashboard_highlight_text" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_screening_coverage"
            android:textColor="@color/dashboard_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:text="@string/dashboard_coverage_subtitle"
            android:textColor="@color/dashboard_ink_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E2E8E6"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="10dp">

                    <org.piramalswasthya.stoptb.custom_views.DonutChartView
                        android:id="@+id/donutCoverage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <TextView
                            android:id="@+id/tvCoverageCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textColor="@color/dashboard_ink"
                            android:textSize="13sp"
                            android:visibility="gone"
                            android:textStyle="bold"
                            tools:text="45 / 120" />

                        <TextView
                            android:id="@+id/tvCoveragePercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/dashboard_ink"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="38%" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_coverage"
                            android:textAllCaps="true"
                            android:textColor="@color/dashboard_ink_muted"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dashboard_village_population"
                        android:textColor="@color/dashboard_ink_muted"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCoveragePopulation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/dashboard_ink"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="120" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/dashboard_row_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dashboard_screened"
                        android:textColor="@color/dashboard_ink_muted"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCoverageScreened"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/dashboard_ink"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="45 (38%)" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/dashboard_row_divider" />

                <LinearLayout
                    android:id="@+id/rowUnscreened"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:orientation="horizontal"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dashboard_unscreened"
                        android:textColor="@color/dashboard_ink_muted"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCoverageUnscreened"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/dashboard_ink"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="75 (62%)" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCoverageFormula"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_dashboard_highlight"
                    android:padding="10dp"
                    android:textColor="@color/dashboard_highlight_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="45 screened out of 120 population — 38% coverage so far." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_screened_population"
                android:textColor="@color/dashboard_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvScreenedPeriodLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/dashboard_ink_muted"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="— Today" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:text="@string/dashboard_screened_population_subtitle"
            android:textColor="@color/dashboard_ink_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E2E8E6"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="8dp">

                    <org.piramalswasthya.stoptb.custom_views.DonutChartView
                        android:id="@+id/donutScreenedDemo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <TextView
                            android:id="@+id/tvScreenedDemoCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/dashboard_ink"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="45" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_screened"
                            android:textAllCaps="true"
                            android:textColor="@color/dashboard_ink_muted"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <include
                    android:id="@+id/rowScreenedMale"
                    layout="@layout/item_dashboard_demo_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/dashboard_row_divider" />

                <include
                    android:id="@+id/rowScreenedFemale"
                    layout="@layout/item_dashboard_demo_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/dashboard_row_divider" />

                <include
                    android:id="@+id/rowScreenedChildren"
                    layout="@layout/item_dashboard_demo_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/dashboard_row_divider" />

                <include
                    android:id="@+id/rowScreenedOthers"
                    layout="@layout/item_dashboard_demo_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/dashboard_row_divider" />

                <include
                    android:id="@+id/rowScreenedSenior"
                    layout="@layout/item_dashboard_demo_row" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/dashboard_overview_title"
            android:textColor="@color/dashboard_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:text="@string/dashboard_overview_subtitle"
            android:textColor="@color/dashboard_ink_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <include
            android:id="@+id/cardPresumptive"
            layout="@layout/item_dashboard_indicator" />

        <include
            android:id="@+id/cardPastHistory"
            layout="@layout/item_dashboard_indicator" />

        <include
            android:id="@+id/cardAntiTb"
            layout="@layout/item_dashboard_indicator" />

        <include
            android:id="@+id/cardXray"
            layout="@layout/item_dashboard_indicator" />

        <include
            android:id="@+id/cardSputum"
            layout="@layout/item_dashboard_indicator" />

        <include
            android:id="@+id/cardTrueNat"
            layout="@layout/item_dashboard_indicator" />

        <include
            android:id="@+id/cardLiquidCulture"
            layout="@layout/item_dashboard_indicator" />

        <include
            android:id="@+id/cardHwc"
            layout="@layout/item_dashboard_indicator" />

        <include
            android:id="@+id/cardConfirmed"
            layout="@layout/item_dashboard_indicator" />

        <include
            android:id="@+id/cardNikshay"
            layout="@layout/item_dashboard_indicator" />

        <include
            android:id="@+id/cardAbha"
            layout="@layout/item_dashboard_indicator" />
    </LinearLayout>
</ScrollView>
