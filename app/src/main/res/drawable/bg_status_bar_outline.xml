<?xml version="1.0" encoding="utf-8"?>
<!-- Unified "Fetching from device… | Last checked… · Auto-refresh…" status bar background —
     TrueNat/RIF/Chest-X-Ray order-status redesign. A subtle bordered box (not a solid-color
     pill) so the pill text/icon segment and the last-checked caption read as one grouped row
     instead of two separately-floating pieces. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#14FFFFFF" />
    <corners android:radius="8dp" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
